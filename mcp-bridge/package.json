{
  "name": "pocket-mcp-bridge",
  "version": "2.0.0",
  "private": true,
  "description": "Zero-dependency stdio bridge + one-command setup helper for PocketMCP",
  "type": "module",
  "main": "bridge.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bridge.mjs",
    "setup": "node setup.mjs",
    "check": "node --check bridge.mjs && node --check setup.mjs",
    "test": "node --test"
  }
}
